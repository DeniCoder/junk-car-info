#: app/templates/base.html:6
msgid "Брошенная техника — народная карта"
msgstr "Vehículos Abandonados — Mapa Popular"

#: app/templates/base.html:7
msgid "Интерактивная карта брошенной техники. Отмечай и находи заброшенные автомобили, тракторы, прицепы у дорог."
msgstr "Mapa interactivo de vehículos abandonados. Marca y encuentra automóviles, tractores, remolques abandonados cerca de las carreteras."

#: app/templates/base.html:22
msgid "Карта"
msgstr "Mapa"

#: app/templates/base.html:23
msgid "Контакты"
msgstr "Contactos"

#: app/templates/base.html:25
msgid "Админ-панель"
msgstr "Panel de Administración"

#: app/templates/base.html:49
msgid "Выйти"
msgstr "Cerrar sesión"

#: app/templates/base.html:53
msgid "Войти"
msgstr "Iniciar sesión"

#: app/templates/base.html:54
msgid "Регистрация"
msgstr "Registro"

#: app/templates/base.html:68
msgid "Политика конфиденциальности"
msgstr "Política de Privacidad"

#: app/templates/base.html:69
msgid "Условия использования"
msgstr "Términos de Uso"

#: app/templates/base.html:72
msgid "© 2024 Брошенная Техника. Все права защищены."
msgstr "© 2024 Vehículos Abandonados. Todos los derechos reservados."

#: app/templates/base.html:78
msgid "Мы используем файлы cookie для улучшения работы сайта. Продолжая использовать сайт, вы соглашаетесь с нашей"
msgstr "Usamos cookies para mejorar el rendimiento del sitio. Al continuar usando el sitio, usted acepta nuestra"

#: app/templates/base.html:79
msgid "политикой cookie"
msgstr "política de cookies"

#: app/templates/base.html:82
msgid "Принять все"
msgstr "Aceptar todo"

#: app/templates/base.html:83
msgid "Отклонить"
msgstr "Rechazar"

#: app/templates/index.html:10
msgid "Добавить технику"
msgstr "Añadir vehículo"

#: app/templates/index.html:15
msgid "Найдено объектов"
msgstr "Objetos encontrados"

#: app/templates/index.html:20
msgid "Поиск по карте..."
msgstr "Buscar en el mapa..."

#: app/auth/views.py:15
msgid "Пожалуйста, войдите для доступа к этой странице."
msgstr "Por favor, inicie sesión para acceder a esta página."

#: app/auth/views.py:25
msgid "Добро пожаловать"
msgstr "Bienvenido"

#: app/auth/views.py:30
msgid "Неверное имя пользователя или пароль."
msgstr "Nombre de usuario o contraseña inválidos."

#: app/auth/views.py:45
msgid "Все поля обязательны для заполнения."
msgstr "Todos los campos son obligatorios."

#: app/auth/views.py:50
msgid "Пароли не совпадают."
msgstr "Las contraseñas no coinciden."

#: app/auth/views.py:55
msgid "Пароль должен быть не менее 6 символов."
msgstr "La contraseña debe tener al menos 6 caracteres."

#: app/auth/views.py:60
msgid "Имя пользователя уже занято."
msgstr "El nombre de usuario ya está ocupado."

#: app/auth/views.py:65
msgid "Email уже зарегистрирован."
msgstr "El correo electrónico ya está registrado."

#: app/auth/views.py:75
msgid "Регистрация успешна! Теперь вы можете войти."
msgstr "¡Registro exitoso! Ahora puede iniciar sesión."

#: app/auth/views.py:85
msgid "Вы вышли из системы."
msgstr "Ha cerrado sesión."

