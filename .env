FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/junk_car_info

MEDIA_ROOT=./media
KEEP_ORIGINAL=false

MAX_UPLOAD_FILES=6
MAX_FILE_SIZE_MB=8
MAX_UPLOAD_SIZE_MB=50

AUTO_PUBLISH=false

ADMIN_TOKEN=dev-admin-token

CLEANUP_ORPHAN_HOURS=24
CLEANUP_REJECTED_DAYS=7
CLEANUP_PENDING_DAYS=30

RATE_LIMIT_STORAGE_URL=memory://
