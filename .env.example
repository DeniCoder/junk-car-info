FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

DATABASE_URL=postgresql://localhost:5432/junk_car_info

MEDIA_ROOT=./media
KEEP_ORIGINAL=false

MAX_UPLOAD_FILES=6
MAX_FILE_SIZE_MB=8
